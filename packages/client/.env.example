# Game server (Colyseus). Use wss://your-app.onrender.com in production.
VITE_SERVER_URL=ws://localhost:2567

# ---- Firebase Web config (OPTIONAL) ----
# Leave empty to play in guest-only mode. Fill in from your Firebase project's
# web app config to enable registration, login, profiles, friends, leaderboard.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
