# ---- Server ----
PORT=2567
# Comma-separated list of allowed origins for CORS, or * for all (dev only)
CORS_ORIGIN=*
# Mount the Colyseus monitor dashboard at /colyseus (dev only — protect in prod)
ENABLE_MONITOR=false

# ---- Firebase Admin (OPTIONAL) ----
# Leave ALL of these empty to run the server in GUEST-ONLY mode
# (no login required, no persistence). Fill them in to enable accounts,
# XP/stats persistence, leaderboards and bans.
#
# Option A (recommended): the full service-account JSON on one line,
# OR its base64 encoding.
FIREBASE_SERVICE_ACCOUNT=
#
# Option B: the three individual fields from the service account.
# Keep the \n escapes in the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
